# Copy this file to .env. DeepSeek sign-in is done by hand in a browser window
# (run `python -m deepseek.auth`), so no DeepSeek credentials are stored here.
#
# OrcaRouter is optional and independent of the DeepSeek session. It accepts an
# existing API key here, or a sign-in from the command line:
#
#   ORCAROUTER_API_KEY=sk-orca-...        # an existing key (takes precedence)
#   python -m server.orcarouter connect   # or authorize with your account
#
# See docs/orcarouter.md. Never commit a real key.

# --- Optional ---
# DEEPSEEK_PROFILE_DIR=session/profile   # reuse an existing signed-in Chrome profile
# HOST=127.0.0.1
# PORT=8000
# RATE_LIMIT_PER_MINUTE=30               # per-client-IP limit on /v1 endpoints

# --- OrcaRouter (optional) ---
# ORCAROUTER_API_KEY=sk-orca-...         # an existing key; overrides a signed-in one
# ORCA_BASE_URL=https://selfhost.example.com   # shared self-hosted base
# ORCA_AUTH_BASE_URL=https://www.orcarouter.ai # auth origin (explicit override)
# ORCA_API_BASE_URL=https://api.orcarouter.ai/v1  # inference base (explicit override)
